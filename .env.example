# EduVerify AI Environment Configuration

# Project & Security
PROJECT_NAME="EduVerify AI"
SECRET_KEY="eduverify-ai-sih2026-super-secure-production-ready-jwt-secret-key-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for zero-config demo, or PostgreSQL)
DATABASE_URL="sqlite:///./eduverify.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduverify"

# Gateway Integration Configuration
INTEGRATION_MODE="SIMULATED" # "SIMULATED" or "CONNECTED"
AICTE_API_BASE_URL="https://api.aicte-india.org/v1/mock"
APAAR_API_BASE_URL="https://api.apaar.gov.in/v1/mock"
AICTE_API_KEY="DEMO-AICTE-API-KEY-2026"
APAAR_API_KEY="DEMO-APAAR-API-KEY-2026"

# Frontend Vite
VITE_API_URL="http://127.0.0.1:8000/api/v1"
